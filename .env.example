# Sebastian's Wonderland OS — provider keys (all optional).
# Copy to .env.local and fill in what you have. The OS runs fully in
# Local Dev Adapter mode without any keys — model calls are then handled
# by a clearly-labeled deterministic local adapter.

# OpenRouter — default everyday brain (Owl Alpha and other free/low-cost models)
OPENROUTER_API_KEY=

# Anthropic Claude — reasoning-heavy plans, long-form planning, code review
ANTHROPIC_API_KEY=

# OpenAI — coding/codex-style work
OPENAI_API_KEY=

# Google Gemini — long-context files and transcripts
GEMINI_API_KEY=

# xAI Grok — multimodal / search workflows
XAI_API_KEY=

# Optional overrides
# SWOS_DATA_DIR=/absolute/path/to/.swos-data
# SWOS_PORT is set via package.json scripts (default 3737)
